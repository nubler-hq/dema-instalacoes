{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demainstalacoes.com.br/schemas/mapa-cotacao.json",
  "title": "Mapa de Cotacao Dema",
  "type": "object",
  "required": [
    "id",
    "name",
    "number",
    "type",
    "customer",
    "suppliers",
    "quotes",
    "items",
    "groups",
    "basket",
    "pendingItems",
    "summary",
    "timestamps"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "number": { "type": "string", "pattern": "^[0-9]{3}$" },
    "type": { "type": "string", "minLength": 1 },
    "customer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sheetName": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "supplierId": { "type": "string" },
          "proposal": { "type": ["string", "null"] },
          "sourceFile": { "type": ["string", "null"] },
          "normalizedFile": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/item" }
          }
        },
        "additionalProperties": true
      }
    },
    "basket": {
      "type": "object",
      "required": ["total", "supplierAllocations"],
      "properties": {
        "total": { "type": "number" },
        "supplierAllocations": { "type": "array" }
      },
      "additionalProperties": true
    },
    "pendingItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "summary": {
      "type": "object",
      "required": ["totalItems", "supplierCount", "groupCount", "itemsWithoutQuotes"],
      "additionalProperties": true
    },
    "timestamps": {
      "type": "object",
      "required": ["generatedAt"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "source": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["position", "description", "quantity", "unit", "offers"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "position": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "quantity": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["supplierId", "available"],
            "properties": {
              "supplierId": { "type": "string" },
              "quoteId": { "type": ["string", "null"] },
              "quoteItemIndex": { "type": ["integer", "null"], "minimum": 0 },
              "unitPrice": { "type": ["number", "null"] },
              "totalPrice": { "type": ["number", "null"] },
              "available": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
